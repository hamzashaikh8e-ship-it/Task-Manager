APP_ENV=development
DATABASE_URL=sqlite:///./taskflow.db
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=INFO
PRIORITY_WEIGHT_DEADLINE=0.30
PRIORITY_WEIGHT_IMPORTANCE=0.25
PRIORITY_WEIGHT_PRIORITY=0.20
PRIORITY_WEIGHT_TIME_FIT=0.15
PRIORITY_WEIGHT_DOWNSTREAM=0.10
VITE_API_URL=/api/v1
VITE_DEV_API_TARGET=http://127.0.0.1:8000


# Production requires PostgreSQL, HTTPS origins, public allowed hosts, and a unique secret.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/taskflow
# APP_ENV=production
# CORS_ORIGINS=https://app.example.com
# ALLOWED_HOSTS=api.example.com

# Gamification rules: XP per first task completion / qualifying focus session, minimum focus duration, and XP per level.
XP_TASK_COMPLETION=10
XP_FOCUS_SESSION=5
XP_FOCUS_MIN_SECONDS=300
XP_LEVEL_SIZE=100
